# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# Limitless Trading Bot Credentials (.env)
# ==========================================

# المفتاح الخاص لمحفظة Web3 (شبكة Base) - يبدأ بـ 0x
PRIVATE_KEY="0x_YOUR_PRIVATE_KEY_HERE"

# معرف رمز الـ API الصادر من Limitless
LMTS_TOKEN_ID="your_limitless_token_id"

# المفتاح السري لرمز الـ API الصادر من Limitless (HMAC Secret)
LMTS_TOKEN_SECRET="your_limitless_token_secret"

# رابط منصة Limitless و Base RPC
LIMITLESS_API_URL="https://api.limitless.exchange"
BASE_RPC_URL="https://mainnet.base.org"
