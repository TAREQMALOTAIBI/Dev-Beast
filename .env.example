# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ====================================================================
# Limitless MML Quantitative Trading Bot Configuration
# ====================================================================
# Base Chain RPC URL (Base Mainnet or Alchemy / Infura / QuickNode)
RPC_URL="https://mainnet.base.org"

# Trader Private Key (Keep strictly secure and never commit real keys)
PRIVATE_KEY=""

# Trader Public Wallet Address (0x...)
WALLET_ADDRESS=""

# Paper Trading Mode (true for simulated test trades, false for live on-chain execution)
PAPER_TRADING="true"

# Risk Management: Fraction of wallet balance per trade (0.01 = 1%)
RISK_PER_TRADE="0.01"

# Maximum Entry Price for Out-Of-The-Money (OTM) Limitless 5m contracts ($0.10)
MAX_ENTRY_PRICE="0.10"

# Maximum Slippage allowance ($0.10)
MAX_SLIPPAGE="0.10"

# Dynamic Flip Profit Target multiplier (3.00 = 300% profit / 4x entry price)
DYNAMIC_FLIP_PROFIT="3.00"

# Anomaly Volume Spike Threshold in standard deviations (2.5 Sigma)
SIGMA_THRESHOLD="2.5"

# Rolling window sample size for CVD & Delta Z-Score calculation
ROLLING_WINDOW_SIZE="120"

# Limitless Prediction Market Contracts on Base
USDC_ADDRESS="0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913"
LIMITLESS_ROUTER="0xD729221C3D6176378411D048b0C7c77d5b1B3736"
BTC_5M_MARKET_ADDRESS="0x1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c"

# Optional SOCKS5 or HTTP proxy to bypass US/Geo-restrictions on Binance WebSocket
PROXY_URL=""

# ====================================================================
# Official Limitless Exchange SDK Scoped API Token (HMAC-SHA256 Auth)
# Generate at limitless.exchange -> profile menu -> API keys
# ====================================================================
LMTS_TOKEN_ID=""
LMTS_TOKEN_SECRET=""

